# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore. Never commit it.

# ---- Sending provider: dryrun (sends nothing) | gmail | smtp
EMAIL_PROVIDER=dryrun

# ---- Test mode: when true, every email goes ONLY to TEST_RECIPIENT
TEST_MODE=true
TEST_RECIPIENT=your.own.address@example.com

# ---- Sender identity (shown in the email signature)
SENDER_NAME=Zehra Zaidi
SENDER_EMAIL=your.address@example.com
SENDER_WEBSITE=
SENDER_POSTAL_ADDRESS=

# ---- Limits
SEND_DELAY_SECONDS=45
DAILY_SEND_LIMIT=50

# ---- Gmail API (OAuth 2.0). Download the OAuth client JSON from Google Cloud
# and save it at this path. The token file is created when you click "Connect Gmail".
GMAIL_CLIENT_SECRET_FILE=credentials/client_secret.json
GMAIL_TOKEN_FILE=credentials/gmail_token.json

# ---- SMTP alternative (only needed if EMAIL_PROVIDER=smtp)
# For Gmail SMTP use smtp.gmail.com, port 587, and a Google "App password".
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=

# ======================================================================
# Website discovery (see README section "Website discovery").
# Every key is optional: discovery still runs without them and leaves the
# matching fields blank. Keys are never logged or written to the CSV.
# ======================================================================

# ---- Search provider: manual | searxng | brave | google_cse
# manual (default, free): generate searches in the dashboard, run them in your browser, import the URLs.
# searxng (free): your own SearXNG server. brave / google_cse are PAID and only used if you add a key.
# A paid provider without a key falls back to manual; nothing switches to a paid service by itself.
SEARCH_PROVIDER=manual
# Brave Search API key (https://api-dashboard.search.brave.com). Paid per request, with a monthly free credit.
BRAVE_API_KEY=
# Google Programmable Search: closed to new customers, existing keys stop working on 2027-01-01.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# Self-hosted SearXNG instance with JSON output enabled, e.g. http://127.0.0.1:8080
SEARXNG_URL=

# ---- SEO metrics (left blank if not configured; never estimated)
# Moz API token (Moz account > API). Gives Domain Authority (DA).
MOZ_API_TOKEN=
# Ahrefs API v3 key (Ahrefs account > Account settings > API keys). Gives Domain Rating (DR).
AHREFS_API_KEY=
# free = free Domain Rating endpoint; paid = site-explorer endpoint (uses API units on a paid plan)
AHREFS_DR_ENDPOINT=free

# ---- Email verification: none | hunter | zerobounce
EMAIL_VERIFY_PROVIDER=none
HUNTER_API_KEY=
ZEROBOUNCE_API_KEY=

# ---- Discovery limits
DISCOVERY_AUTO_ON_STARTUP=true
DISCOVERY_DAILY_LIMIT=25
# Imported websites (free workflow) inspected per run; the rest wait in the queue.
DISCOVERY_IMPORT_MAX_PER_RUN=50

# ---- Claude auto-discovery (uses your Claude plan via the `claude` command; no API key)
CLAUDE_DISCOVERY_PER_NICHE=8
CLAUDE_DISCOVERY_MAX_TURNS=40
CLAUDE_DISCOVERY_TIMEOUT_SECONDS=1500
# Leave blank to find `claude` automatically.
CLAUDE_CLI_PATH=
DISCOVERY_MAX_SEARCHES=12
DISCOVERY_MAX_SEARCHES_MONTH=900
DISCOVERY_MAX_REQUESTS_PER_DOMAIN=6
DISCOVERY_REQUEST_DELAY_SECONDS=1.5
DISCOVERY_SEARCH_CACHE_DAYS=14
DISCOVERY_REVISIT_DAYS=30
METRICS_MAX_LOOKUPS_PER_RUN=25
METRICS_REFRESH_DAYS=30
EMAIL_VERIFY_MAX_PER_RUN=25
